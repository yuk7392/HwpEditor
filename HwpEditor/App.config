<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- ★ bindingRedirect 를 미리 적지 않는다(G-2). 서드파티는 AssemblyResolve 가 이름으로만 찾아
       byte[] 로 올리므로 대개 필요 없고, 실제로 예외가 나는 것만 실측 버전으로 추가한다. -->
</configuration>
